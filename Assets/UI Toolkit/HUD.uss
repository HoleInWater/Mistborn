/* ═══════════════════════════════════════════════════════════════════
   HUD.uss — Mistborn Allomancy HUD
   - Health / Stamina bars (top-left, large)
   - Two selected metal bars (bottom-right, above ring)
   - Spinning ring indicator (bottom-right corner)
   ═══════════════════════════════════════════════════════════════════ */

/* ── Health ────────────────────────────────────────────────────── */

#Health .unity-progress-bar__container {
    height: 28px;
}

#Health .unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.75);
    border-width: 1px;
    border-color: rgb(100, 20, 20);
    border-radius: 4px;
}

#Health .unity-progress-bar__progress {
    background-color: rgb(200, 30, 30);
    border-radius: 3px;
}

#Health .unity-progress-bar__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    padding-left: 6px;
}

/* ── Stamina ───────────────────────────────────────────────────── */

#Stamina .unity-progress-bar__container {
    height: 22px;
}

#Stamina .unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.75);
    border-width: 1px;
    border-color: rgb(20, 80, 20);
    border-radius: 4px;
}

#Stamina .unity-progress-bar__progress {
    background-color: rgb(27, 220, 0);
    border-radius: 3px;
}

#Stamina .unity-progress-bar__title {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.8);
    -unity-text-align: middle-left;
    padding-left: 6px;
}

/* ── Two selected metal bars (bottom-right, above ring) ────────── */

.SelectedMetals {
    flex-direction: column;
    position: absolute;
    bottom: 130px;
    right: 16px;
    width: 180px;
}

.SelectedMetalBar {
    width: 176px;
    height: 26px;
    margin-bottom: 5px;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.SelectedMetalBar .unity-progress-bar__container {
    height: 100%;
}

.SelectedMetalBar .unity-progress-bar__background {
    background-color: rgb(14, 14, 14);
    border-width: 1px;
    border-color: rgb(55, 55, 55);
    border-radius: 3px;
}

.SelectedMetalBar .unity-progress-bar__progress {
    background-color: rgb(160, 180, 210);
    border-radius: 2px;
}

.SelectedMetalBar .unity-progress-bar__title {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.65);
    -unity-text-align: middle-left;
    padding-left: 5px;
}

/* Active metal — bright white border */
.SelectedMetalBar.active-metal .unity-progress-bar__background {
    border-color: rgb(255, 255, 255);
    border-width: 2px;
    background-color: rgb(30, 30, 30);
}

.SelectedMetalBar.active-metal .unity-progress-bar__title {
    color: rgb(255, 255, 255);
    font-size: 12px;
}

/* Secondary metal — grey dotted border */
.SelectedMetalBar.secondary-metal .unity-progress-bar__background {
    border-color: rgb(150, 150, 150);
    border-width: 1.5px;
    border-style: dotted;
}

.SelectedMetalBar.secondary-metal .unity-progress-bar__title {
    color: rgba(255, 255, 255, 0.75);
}

/* Low reserve — red fill */
.SelectedMetalBar.low-reserve .unity-progress-bar__progress {
    background-color: rgb(180, 30, 10) !important;
}

.SelectedMetalBar.low-reserve .unity-progress-bar__title {
    color: rgb(255, 80, 60);
}

/* Duralumin / Nicrosil primed — gold border */
.SelectedMetalBar.burst-primed .unity-progress-bar__background {
    border-color: rgb(255, 200, 50);
    border-width: 2px;
}

/* ── Spinning ring indicator (bottom-right corner) ─────────────── */

.MetalRingContainer {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 90px;
    height: 90px;
}

/* Dim background circle */
.MetalRingBg {
    position: absolute;
    left: 5px;
    top: 5px;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border-width: 5px;
    border-color: rgba(50, 50, 50, 0.6);
    background-color: rgba(0, 0, 0, 0.45);
}

/* The spinning arc — top + right borders visible, bottom + left hidden */
.MetalRingSpinner {
    position: absolute;
    left: 5px;
    top: 5px;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 0px;
    border-left-width: 0px;
    border-top-color: rgb(160, 180, 210);
    border-right-color: rgb(160, 180, 210);
    background-color: rgba(0, 0, 0, 0);
    /* Rotated each frame by MetalReserve.cs */
}

/* Primed state — gold arc */
.MetalRingSpinner.burst-primed {
    border-top-color: rgb(255, 200, 50);
    border-right-color: rgb(255, 200, 50);
}

/* Metal name — centered in ring */
.MetalName {
    position: absolute;
    left: 0px;
    top: 26px;
    width: 90px;
    -unity-text-align: middle-center;
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(200, 200, 200);
}

/* Reserve percentage — below name */
.MetalPct {
    position: absolute;
    left: 0px;
    top: 42px;
    width: 90px;
    -unity-text-align: middle-center;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}
