:root {
}

.HUD {
}

.Metal {
}

.Health {
}

#Health .unity-progress-bar__progress {
    background-color: rgb(255, 0, 0);
}

#Health .unity-progress-bar__background {
    background-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    font-size: 20px;
}

/* Metal Container Styles */
.MetalContainer {
    margin-bottom: 20px;
}

.MetalBar {
    width: 40%;
    margin-right: 8%; /* Creates a dedicated gap to prevent scaling occlusion overlaps */
    height: 30px;
    margin: 0;
    padding: 0;
}

.MetalBar .unity-progress-bar__container {
    height: 100%;
}

.MetalBar .unity-progress-bar__background {
    background-color: rgb(30, 30, 30);
    border-width: 1px;
    border-color: rgb(50, 50, 50);
}

.MetalBar .unity-progress-bar__title {
    font-size: 8px;
    color: rgba(255, 255, 255, 0.5);
}

/* Selection Highlights */
.MetalBar.active-metal .unity-progress-bar__background {
    border-color: rgb(255, 255, 255);
    border-width: 4px; /* Dramatically thickened border to replace scaling */
    background-color: rgb(50, 50, 50); /* Brighter base so it visually pops */
}

.MetalBar.secondary-metal .unity-progress-bar__background {
    border-color: rgb(150, 150, 150);
    border-width: 1.5px;
    border-style: dotted;
}

/* Specific Metal Colors */
#Metal_Steel .unity-progress-bar__progress { background-color: rgb(192, 192, 192); }
#Metal_Iron .unity-progress-bar__progress { background-color: rgb(128, 128, 128); }
#Metal_Pewter .unity-progress-bar__progress { background-color: rgb(169, 169, 169); }
#Metal_Tin .unity-progress-bar__progress { background-color: rgb(211, 211, 211); }
#Metal_Zinc .unity-progress-bar__progress { background-color: rgb(245, 245, 220); }
#Metal_Brass .unity-progress-bar__progress { background-color: rgb(181, 166, 66); }
#Metal_Copper .unity-progress-bar__progress { background-color: rgb(184, 115, 51); }
#Metal_Bronze .unity-progress-bar__progress { background-color: rgb(205, 127, 50); }
#Metal_Atium .unity-progress-bar__progress { background-color: rgb(0, 0, 0); }
#Metal_Malatium .unity-progress-bar__progress { background-color: rgb(50, 50, 50); }
#Metal_Gold .unity-progress-bar__progress { background-color: rgb(255, 215, 0); }
#Metal_Electrum .unity-progress-bar__progress { background-color: rgb(255, 250, 205); }
#Metal_Aluminum .unity-progress-bar__progress { background-color: rgb(220, 220, 220); }
#Metal_Duralumin .unity-progress-bar__progress { background-color: rgb(105, 105, 105); }
#Metal_Bendalloy .unity-progress-bar__progress { background-color: rgb(255, 127, 80); }
#Metal_Cadmium .unity-progress-bar__progress { background-color: rgb(135, 206, 235); }

#Stamina .unity-progress-bar__progress {
    background-color: rgb(27, 255, 0);
}

#Stamina .unity-progress-bar__background {
    background-color: rgb(0, 0, 0);
}
