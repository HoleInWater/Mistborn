<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/HUD.uss?fileID=7433441132597879392&amp;guid=10a28823af41bb24f89b59c1e8165c75&amp;type=3#HUD"/>

    <!-- Health bar — top-left, large -->
    <ui:ProgressBar value="100" title="Health" name="Health" class="HUD Health"
        style="position: absolute; top: 16px; left: 16px; width: 300px;" />

    <!-- Stamina bar — below health, large -->
    <ui:ProgressBar value="100" title="Stamina" name="Stamina" class="HUD Stamina"
        style="position: absolute; top: 62px; left: 16px; width: 300px;" />

    <!-- Two selected metals — bottom right, stacked above ring -->
    <ui:VisualElement name="SelectedMetals" class="SelectedMetals">
        <ui:ProgressBar value="100" title="Steel" name="PrimaryMetalBar"   class="HUD SelectedMetalBar"/>
        <ui:ProgressBar value="100" title="Iron"  name="SecondaryMetalBar" class="HUD SelectedMetalBar"/>
    </ui:VisualElement>

    <!-- Proportional ring indicator — bottom right corner.
         MetalRingVisual (two arcs) is injected here by MetalReserve.cs at runtime. -->
    <ui:VisualElement name="MetalRingContainer" class="MetalRingContainer">
        <ui:Label name="MetalName" class="MetalName" text="STEEL"/>
        <ui:Label name="MetalPct"  class="MetalPct"  text="100%"/>
    </ui:VisualElement>

</ui:UXML>
